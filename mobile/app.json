{
  "expo": {
    "name": "Snap Mandarin",
    "slug": "snap-mandarin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lqtrung95.snapmandarin",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Snap Mandarin uses your camera to photograph objects so it can detect them and teach you the Chinese words for what's in the scene.",
        "NSPhotoLibraryUsageDescription": "Snap Mandarin needs access to your photos so you can analyze an existing picture and set a profile avatar."
      }
    },
    "android": {
      "package": "com.lqtrung95.snapmandarin",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#131313",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-audio",
      "expo-notifications"
    ],
    "scheme": "aiimagedict"
  }
}
