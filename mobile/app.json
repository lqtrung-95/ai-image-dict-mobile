{
  "expo": {
    "name": "Snap Mandarin",
    "slug": "snap-mandarin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#131313"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lqtrung95.snapmandarin",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Snap Mandarin uses your camera to photograph objects so it can detect them and teach you the Chinese words for what's in the scene.",
        "NSPhotoLibraryUsageDescription": "Snap Mandarin needs access to your photos so you can analyze an existing picture and set a profile avatar.",
        "NSMicrophoneUsageDescription": "Snap Mandarin uses the microphone to play back Chinese pronunciation using text-to-speech audio.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.lqtrung95.snapmandarin",
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#131313",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-audio",
      "expo-splash-screen",
      "expo-notifications",
      "expo-font",
      "expo-image-picker",
      "expo-localization"
    ],
    "scheme": "aiimagedict",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "47b50771-6df8-431d-944a-cd2aa80659af"
      }
    },
    "owner": "lqtrung.dev",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/47b50771-6df8-431d-944a-cd2aa80659af"
    }
  }
}
